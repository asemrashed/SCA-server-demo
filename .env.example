# Production overrides: `sca-server/.env.production`, `sca-client/.env.production`
# CORS_ORIGIN supports comma-separated origins in production.

NODE_ENV=development
PORT=4000

# DATABASE_URL: Neon pooler (app runtime). DIRECT_URL: direct host (migrations).
# Append &connect_timeout=30 if Neon was asleep and first connect times out.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30

JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SESSION_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:3000

# Local file storage (VPS)
UPLOAD_DIR=./uploads
# Required in production — public URL where /uploads is served
# PUBLIC_UPLOAD_BASE_URL=https://api.sharifcommerceacademy.com/uploads

ADMIN_WHATSAPP_PHONE=01638149875

# Password reset emails (Gmail app password for adminsharifca@gmail.com)
CLIENT_URL=http://localhost:3000
PASSWORD_RESET_EXPIRES_IN=1h
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adminsharifca@gmail.com
# SMTP_PASS=your-gmail-app-password
SMTP_FROM=SCA <adminsharifca@gmail.com>
PLATFORM_NAME=SCA
